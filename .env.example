# Admin password for /admin/login

# Supabase (required for admin leads inbox)
# 1) Create free project at https://supabase.com
# 2) Project Settings → API → copy Project URL + anon public key
# 3) SQL Editor → run supabase/leads.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical production website origin for SEO and the sitemap
VITE_SITE_URL=https://saraaviation.in

# Set these in Vercel Production after applying supabase/staff_seo.sql.
SEO_FETCH_PUBLISHED=false
SEO_DEPLOY_HOOK_URL=

# Supabase staff account used by the password-only login screen
VITE_ADMIN_EMAIL=

# Optional password for the loopback-only Vite development login
VITE_LOCAL_ADMIN_PASSWORD=
